# PostgreSQL initialization settings (applied only to an empty database volume).
POSTGRES_DB=rovira
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Match the credentials above. Inside Compose, the database hostname is piezalia-db.
DATABASE_URL=postgresql://postgres:postgres@piezalia-db:5432/rovira

# Compose starts the simulator by default: docker compose up -d --build
PORTAL_BASE_URL=http://portal:8080
PORTAL_TIMEOUT_SECONDS=10
SYNC_RETRY_ATTEMPTS=5
SYNC_RETRY_BASE_SECONDS=1
SYNC_RETRY_CAP_SECONDS=30
SYNC_RETRY_BUDGET_SECONDS=120
